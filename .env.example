# Token privado entregado por @BotFather. Nunca lo publiques ni lo confirmes en Git.
TELEGRAM_BOT_TOKEN=123456789:REEMPLAZAR_CON_TOKEN_REAL

# PostgreSQL usado por Docker Compose y por la aplicación ejecutada en el host.
POSTGRES_DB=galapagos_previene
POSTGRES_USER=galapagos
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_PORT=5432
DATABASE_URL=postgresql://galapagos:cambiar_por_una_clave_segura@localhost:5432/galapagos_previene

# Valores opcionales (los mostrados son los valores predeterminados).
MAX_MEDIA_FILES=10
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
LOG_LEVEL=INFO
