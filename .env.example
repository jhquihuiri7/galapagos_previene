# Token privado entregado por @BotFather. Nunca lo publiques ni lo confirmes en Git.
TELEGRAM_BOT_TOKEN=123456789:REEMPLAZAR_CON_TOKEN_REAL

# PostgreSQL usado por Docker Compose y por la aplicación ejecutada en el host.
POSTGRES_DB=galapagos_previene
POSTGRES_USER=galapagos
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_PORT=5432
DATABASE_URL=postgresql://galapagos:cambiar_por_una_clave_segura@localhost:5432/galapagos_previene

# Valores opcionales (los mostrados son los valores predeterminados).
MAX_MEDIA_FILES=10
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API REST de lectura (servicio `api`), consumida por SIGTAR.
# ---------------------------------------------------------------------------

# Contraseña del rol de solo lectura. Debe coincidir con la usada al aplicar
# sql/api_readonly.sql. NO es la misma que POSTGRES_PASSWORD: la API no debe
# poder escribir en la base.
API_DB_PASSWORD=cambiar_por_una_clave_segura

# Claves que autorizan a los consumidores, separadas por coma. Mínimo 32
# caracteres cada una. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=reemplazar_por_una_clave_de_al_menos_32_caracteres

# Solo se publica en 127.0.0.1; SIGTAR corre en esta misma VM.
API_PORT=8080

# Al ejecutar la API fuera de Docker, apuntando al PostgreSQL del host.
API_DATABASE_URL=postgresql://galapagos_api:cambiar_por_una_clave_segura@localhost:5432/galapagos_previene

# Valores opcionales (los mostrados son los predeterminados).
API_MEDIA_CHUNK_SIZE=65536
API_MEDIA_TIMEOUT_SECONDS=60
API_DB_POOL_MIN_SIZE=1
API_DB_POOL_MAX_SIZE=10
API_DB_COMMAND_TIMEOUT=30
